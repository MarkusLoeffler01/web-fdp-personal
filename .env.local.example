# Umgebungsvariablen für Produktion / Docker Compose
# Diese Datei dient nur als Vorlage und wird nicht eingecheckt.
# Für Docker Compose solltest du sie nach `.env` kopieren.

# ──────────────────────────────────────────────
# PostgreSQL / Prisma
# ──────────────────────────────────────────────
POSTGRES_DB="website"
POSTGRES_USER="website"
POSTGRES_PASSWORD="bitte-sicheres-passwort-setzen"
DATABASE_URL="postgresql://website:bitte-sicheres-passwort-setzen@db:5432/website?schema=public"

# ──────────────────────────────────────────────
# NextAuth.js v5
# ──────────────────────────────────────────────
# Generiere einen sicheren Wert: openssl rand -base64 32
AUTH_SECRET="hier-einen-langen-zufälligen-wert-eintragen"
AUTH_URL="https://fdp.m-loeffler.de"

# Nur relevant, wenn du mehrere Instanzen / Rolling Deployments nutzt.
# Beispiel: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ──────────────────────────────────────────────
# E-Mail-Versand (Nodemailer / SMTP)
# ──────────────────────────────────────────────
SMTP_HOST="mail.m-loeffler.de"
SMTP_PORT="587"
SMTP_SECURE="false"          # true für Port 465
SMTP_USER="fdp@m-loeffler.de"
SMTP_PASS="dein-smtp-passwort"
SMTP_FROM="Website <noreply@m-loeffler.de>"
CONTACT_EMAIL="fdp@m-loeffler.de"

# ──────────────────────────────────────────────
# Supabase Storage (Bildupload)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-id>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ──────────────────────────────────────────────
# SEO / Site URL
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://fdp.m-loeffler.de"

# ──────────────────────────────────────────────
# Instagram API
# ──────────────────────────────────────────────
# Bearer-Token für https://instagram-token-scraper-api.m-loeffler.de
INSTAGRAM_ADMIN_TOKEN="dein-token-hier"

# ──────────────────────────────────────────────
# OpenClaw Webhook
# ──────────────────────────────────────────────
# Gemeinsames Secret zwischen OpenClaw und Next.js.
# Generiere einen sicheren Wert: openssl rand -hex 32
WEBHOOK_SECRET="hier-einen-langen-zufälligen-wert-eintragen"
